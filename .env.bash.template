# Immich configuration & secrets.
# Copy to .env.bash, fill in, and keep out of git.
# Sourced from the repo root, so $(pwd) is this directory.

########################################
# NAS mount (photo library)
########################################
export smb_host="silverplate.local"
export smb_drive="immich"
# Mount point for the share, relative to this repo
export mount_dir="immich_data_mnt"
# Credentials file on the server, mode 0600, containing:
#   username=foo
#   password=bar
export smb_creds_file="/etc/samba/creds_immich_data"
# Files on the mount appear owned by this user/group. Immich's containers run
# as root internally, but CIFS rewrites ownership to these values, so this is
# what decides who can read the library from the host.
export mount_user="nobody"
export mount_group="immich"

########################################
# Immich
########################################
# Pin an exact release. "release" tracks latest, "v3" tracks the v3 major.
# Immich is pre-1.0-style: minor releases can carry breaking changes, so pin
# exactly and bump deliberately after reading the release notes.
export IMMICH_VERSION="v3.2.0"

export TZ="America/Toronto"

# Photo/video library: originals, thumbnails, uploads, profile images.
# Lives on the NAS mount. Immich requires this to be a single location it
# owns; do not point it at an existing photo folder (use an External Library
# for that instead).
export UPLOAD_LOCATION="$(pwd)/immich_data_mnt/immich/library"

# Postgres data directory. MUST be on local disk: Immich does not support the
# database on a network share (same file-locking reason as the *arr SQLite DBs
# in plex-pms).
export DB_DATA_LOCATION="$(pwd)/local_data_mnt/immich/postgres"

# Machine-learning model cache (a few GB). Local disk; it is a cache, models
# are re-downloaded if lost.
export IMMICH_MODEL_CACHE_DIR="$(pwd)/local_data_mnt/immich/model_cache"

# Host interface & port the web UI binds to. 0.0.0.0 = all interfaces; use
# 127.0.0.1 if the reverse proxy runs on this host, or a LAN IP to pin one
# interface.
export IMMICH_BIND_ADDR="0.0.0.0"
export IMMICH_HOST_PORT="2283"

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For header
# Immich should trust, e.g. "10.8.0.22". Empty means Immich's default of
# link-local + unique-local, which already covers a LAN reverse proxy and the
# docker bridge; set it to narrow that trust to the one proxy. Invalid values
# make the server refuse to start.
export IMMICH_TRUSTED_PROXIES=""

# Seconds of inactivity before the ML service unloads a model from RAM.
# Raise it if ML jobs are frequent and there is RAM to spare; 0 = never unload.
export MACHINE_LEARNING_MODEL_TTL="300"

# verbose | debug | log | warn | error
export IMMICH_LOG_LEVEL="log"

########################################
# Database
########################################
# Use only A-Za-z0-9 - special characters break the connection string.
# Generate one with: openssl rand -hex 24
export DB_PASSWORD="CHANGEME"
# These do not need to change.
export DB_USERNAME="postgres"
export DB_DATABASE_NAME="immich"

########################################
# Alerting
########################################
# Discord webhook for infrastructure notifications. Created in Discord under
#   Server Settings -> Integrations -> Webhooks.
#
# Every unit carries OnFailure=immich-alert@%n.service, so a failed mount,
# container start, backup or backup verification posts here with the last 25
# journal lines.
#
# Leave empty to disable alerting entirely - scripts/notify-discord.sh then
# does nothing and exits cleanly.
#
# This is a secret: anyone holding it can post to the channel.
export DISCORD_WEBHOOK_URL=""

# Post a weekly "backup verified" message as well as failures. Silence is
# ambiguous - it means either "everything is fine" or "the timer stopped
# running in June". A heartbeat distinguishes them. Set to false for failures
# only.
export DISCORD_HEARTBEAT="true"

########################################
# Offsite backup (restic -> S3)
########################################
# The photo library lives on the NAS, which is one copy, not a backup: a
# deleted directory or a failed volume propagates there immediately. This is
# the offsite copy. See docs/backup-restore.md.
#
# Pin exactly, like every other image here.
export RESTIC_VERSION="0.18.1"

# restic speaks S3 generically, so any S3-compatible store works - switch
# providers by changing the endpoint and bucket and nothing else.
# Linode:     https://<region>.linodeobjects.com
# Backblaze:  https://s3.<region>.backblazeb2.com
#
# Use a SEPARATE bucket and a bucket-scoped access key from any other backup
# on this account, so the two can be revoked and retained independently.
# The bucket must already exist; restic creates the repository inside it.
export S3_ENDPOINT="https://ca-central-1.linodeobjects.com"
export S3_BUCKET="hugo-immich"
export RESTIC_REPOSITORY="s3:${S3_ENDPOINT}/${S3_BUCKET}"

export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""

# Encrypts the repository. WITHOUT THIS PASSWORD THE BACKUP IS UNRECOVERABLE.
# Store it somewhere that is not this server and not the NAS.
# Generate one with: openssl rand -base64 32
export RESTIC_PASSWORD=""

# restic's local cache. Local disk, and NOT backed up - it is a cache, rebuilt
# on demand. Without it every run re-downloads repository metadata.
export restic_cache_dir="$(pwd)/local_data_mnt/immich/restic-cache"

# Regenerable derived data. Both are excluded by default: they are large, they
# churn, and Immich rebuilds them. Thumbnails cost hours of regeneration on a
# large library; transcodes cost more but are only needed for playback of
# formats the client cannot handle.
#
# Originals (library/, upload/), profile images and the database dumps are
# always included and are not optional.
export BACKUP_INCLUDE_THUMBS="false"
export BACKUP_INCLUDE_ENCODED_VIDEO="false"

# The database is NOT backed up from its data directory - copying the files of
# a running Postgres does not produce a restorable backup. Immich's own nightly
# dump job writes a gzipped dump into UPLOAD_LOCATION/backups, which is on the
# NAS and therefore inside the snapshot. Enable it under
#   Administration -> Settings -> Backup Settings
# and leave it running earlier in the night than the backup timer.
#
# scripts/backup.sh checks the newest dump is younger than this many hours. It
# still takes the snapshot if the dump is stale - photos are worth capturing
# either way - but exits non-zero afterwards so the failure alerts. A dump job
# that quietly stopped is how a backup ends up holding photos and no albums,
# faces or metadata. Set to 0 to disable the check.
export IMMICH_DB_DUMP_MAX_AGE_HOURS="26"

# How restic decides a file is unchanged. On CIFS, inode numbers are assigned
# by the client and can change across a remount; when they do, restic re-reads
# the entire library over SMB. Deduplication means nothing is re-uploaded, but
# the read takes hours. --ignore-inode drops inode numbers from the comparison
# and leaves size and mtime. If a second run still reports most of the library
# as changed, add --ignore-ctime as well.
export RESTIC_SCAN_FLAGS="--ignore-inode"

# Upload rate cap in KiB/s. The first backup uploads the whole library and will
# otherwise saturate the home connection for days. 0 = unlimited.
export RESTIC_UPLOAD_LIMIT_KIB="0"

# Share of the repository that scripts/check-backup.sh re-reads and verifies.
# `restic check` alone only validates metadata; this is the part that proves
# the bytes come back. Leave empty for the default, which is a rotating
# 1/53 slice keyed to the week number, so the whole repository is read back
# about once a year at a steady weekly egress cost.
export RESTIC_CHECK_SUBSET=""

# Snapshots to keep. Immich's trash holds deleted photos for 30 days; these
# are what cover a deletion noticed after that.
export RESTIC_KEEP_DAILY="7"
export RESTIC_KEEP_WEEKLY="5"
export RESTIC_KEEP_MONTHLY="12"
export RESTIC_KEEP_YEARLY="75"
